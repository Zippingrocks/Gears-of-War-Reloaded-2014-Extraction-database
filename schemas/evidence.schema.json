{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zippingrocks/Gears-of-War-Reloaded-2014-Extraction-database/schemas/evidence.schema.json",
  "title": "Gears of War Reloaded extraction evidence claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "revision", "state", "confidence", "scope", "claim", "evidence", "limitations"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "revision": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["hypothesis", "observed", "decoded", "validated", "rejected", "unknown"] },
    "confidence": { "enum": ["low", "medium", "high"] },
    "scope": {
      "type": "object",
      "required": ["game", "platform"],
      "properties": {
        "game": { "const": "gears-of-war-reloaded" },
        "platform": { "const": "pc-steam-build-20087529" },
        "build": { "type": ["string", "null"] },
        "root": { "type": "string" },
        "maps": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "packages": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "objects": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "claim": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": { "type": "string" },
          "ref": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
