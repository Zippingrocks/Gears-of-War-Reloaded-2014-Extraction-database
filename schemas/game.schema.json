{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zippingrocks/Gears-of-War-Reloaded-2014-Extraction-database/schemas/game.schema.json",
  "title": "Gears of War Reloaded repository metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "releaseYear", "repositoryStatus", "engineFamily", "platforms"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "const": "gears-of-war-reloaded" },
    "title": { "const": "Gears of War: Reloaded" },
    "releaseYear": { "const": 2025 },
    "repositoryStatus": { "enum": ["research", "experimental", "supported"] },
    "engineFamily": { "type": "string", "minLength": 1 },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "steamAppId", "buildId", "executableVersion", "status", "anchorMap"],
        "properties": {
          "id": { "type": "string" },
          "displayName": { "type": "string" },
          "steamAppId": { "const": 2523720 },
          "buildId": { "type": "string" },
          "executableVersion": { "type": "string" },
          "status": { "enum": ["research", "experimental", "supported"] },
          "anchorMap": { "type": "string" }
        }
      }
    }
  }
}
